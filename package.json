{
  "name": "markdown-math-intellisense",
  "displayName": "Markdown Math Intellisense",
  "description": "An extension for Visual Studio Code that provides intellisense for math in markdown files.",
  "publisher": "StefanoDeVuono",
  "licence": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanoDeVuono/markdown-math-intellisense"
  },
  "version": "1.1.1",
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets.json"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint",
    "test": "vscode-test"
  },
  "extensionDependencies": [
    "James-Yu.LaTeX-Workshop"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/eslint__js": "^8.42.3",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/tmp": "^0.2.6",
    "@types/vscode": "^1.115.0",
    "@typescript-eslint/parser": "^8.58.2",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "latex-workshop": "github:James-Yu/LaTeX-Workshop",
    "npm-run-all": "^4.1.5",
    "tmp": "^0.2.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-markdown-languageservice": "^0.5.0-alpha.11"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "remark": "^15.0.1",
    "remark-math": "^6.0.0"
  }
}
